# Development Environment Configuration
# Suppress dev server WebSocket connection errors from browser extensions
VITE_DEV_SERVER_SILENCE_WEBSOCKET_WARNINGS=true

# Enable better error reporting in development
VITE_SHOW_ERROR_OVERLAY=false

# Suppress DOM nesting warnings from browser extensions
VITE_SUPPRESS_DOM_WARNINGS=true
VITE_SUPPRESS_EXTENSION_WARNINGS=true

# Development API endpoints (if needed later)
# VITE_API_BASE_URL=http://localhost:3000

# Development debugging
VITE_DEBUG_MODE=true

# React DevTools configuration
REACT_EDITOR=code